# Copy to .env.local and fill in. Never commit real values (.env* is git-ignored).

# --- AI provider ------------------------------------------------------------
# Gemini is the default provider (free tier key: https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Default gemini-2.5-flash; falls back to gemini-2.0-flash automatically if the model 404s.
GEMINI_MODEL=gemini-2.5-flash
# Optional alternative provider: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# gemini | openrouter. Empty = auto (Gemini first, whichever key exists).
LLM_PROVIDER=
# Users can also paste their own Gemini/OpenRouter key in the workspace UI (kept in their browser only).

# --- Supabase (Postgres) ---------------------------------------------------
# Project Settings -> API. The service-role / secret key is SERVER-ONLY; never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Extraction ------------------------------------------------------------
# Optional. If set, Firecrawl is tried first for URL extraction.
FIRECRAWL_API_KEY=
# Optional. Jina Reader works keyless but may block anonymous traffic from some IPs; a key avoids that.
JINA_API_KEY=

# --- Permitted web search (optional) ---------------------------------------
# Enables "Find sources" in the workspace (https://tavily.com). Without it the box shows "configuration required".
TAVILY_API_KEY=

# --- App -------------------------------------------------------------------
# Public base URL (sent as HTTP-Referer to OpenRouter). Default http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local demo without a database: GAPLENS_DB=memory (data lost on restart). Leave unset in production.
GAPLENS_DB=
