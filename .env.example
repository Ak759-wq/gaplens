# Copy to .env.local and fill in. Never commit real values (.env* is git-ignored).

# --- AI (OpenRouter) -------------------------------------------------------
# Required for analysis (Phase 2+). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id that supports JSON mode. Default: openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Supabase (Postgres) ---------------------------------------------------
# Project Settings -> API. The service-role key is SERVER-ONLY; never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Extraction ------------------------------------------------------------
# Optional. If set, Firecrawl is used for URL extraction; otherwise Jina Reader (keyless) is used.
FIRECRAWL_API_KEY=
# Optional. Raises Jina Reader rate limits.
JINA_API_KEY=

# --- App -------------------------------------------------------------------
# Public base URL (used as HTTP-Referer for OpenRouter). Default http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
